# Soroban test snapshots from property/fuzz tests. These regenerate on every
# run, one file per generated case (thousands for the proptest suites), and
# carry no signal. Only the hand-written `test_snapshots/test/` set is tracked.
contracts/*/test_snapshots/state_machine_test/
contracts/*/test_snapshots/lifecycle_invariants_test/
contracts/*/test_snapshots/gas_regression_test/
contracts/*/test_snapshots/tournament_lifecycle_test/
contracts/*/proptest-regressions/

# Playwright test artifacts
app/playwright-report/
app/test-results/
app/e2e/tests/screenshot-snapshots/__diff_output__/
**/__screenshots__/__diff_output__/

*storybook.log
storybook-static
